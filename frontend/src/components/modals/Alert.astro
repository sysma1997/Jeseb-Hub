---
import { createTranslations, type Locale } from "../../core/shared/infrastructure/i18n/server";

import Base from "./Base.astro";

const locale = Astro.props?.locale ?? "en";
const t = createTranslations(locale as Locale);

const title = Astro.props?.title ?? t("shared.warning");
---

<Base id="alert" title={title}>
    <div class="modal-body">
        <p id="alertMessage"></p>
    </div>
    <div class="modal-footer">
        <button id="alertOk" class="btn-primary">Ok</button>
    </div>
</Base>

<script>
    import { t } from "../../core/shared/infrastructure/i18n";

    const modal = document.getElementById("alert") as HTMLDivElement;
    const modalClose = modal.querySelector('.modal-close') as HTMLButtonElement;
    const modalMessage = document.getElementById("alertMessage") as HTMLParagraphElement;
    const modalOk = document.getElementById("alertOk") as HTMLButtonElement;

    modalOk!.onclick = () => modal!.classList.remove('is-active');

    window.showAlert = (message: string, title: string = "Warning", okAction?: () => void) => {
        if (modalMessage) modalMessage.innerHTML = message;
        if (modal!.querySelector('.modal-header h3')) {
            const tTitle = (title === "Warning") ? t("shared.warning") : title;
            modal!.querySelector('.modal-header h3')!.textContent = tTitle;
        }
        modal!.classList.add('is-active');

        modalClose!.onclick = () => {
            modal!.classList.remove("is-active");
            if (okAction) okAction();
        }
        modalOk!.onclick = () => {
            modal!.classList.remove('is-active');
            if (okAction) okAction();
        };
    };
</script>
