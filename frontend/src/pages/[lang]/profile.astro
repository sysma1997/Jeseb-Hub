---
import type { GetStaticPaths } from "astro";
import { getLocaleFromUrl, createTranslations } from "../../core/shared/infrastructure/i18n/server";

import { Icon } from "astro-icon/components";

import Layout from "../../layouts/Layout.astro";

import Content from "../../components/shared/Content.astro";
import Base from "../../components/modals/Base.astro";
import Alert from "../../components/modals/Alert.astro";
import Confirm from "../../components/modals/Confirm.astro";

import "../../styles/profile.css";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } }, 
		{ params: { lang: "es" } }
	];
}) satisfies GetStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslations(locale);
---

<Layout locale={locale} title={t("profile.title")}>
    <Content locale={locale} hideAddButton>
        <div class="profile">
            <div class="profile-content">
                <div class="profileSidebar">
                    <aside class="profileMenu">
                        <p class="menu-label">{t("profile.menu.title")}</p>
                        <ul id="uMenuList" class="menu-list">
                            <li><a id="aMenuInformation" class="menu-item is-active">
                                <Icon name="solar:user-bold" width={20} height={20} />
                                <label>{t("profile.menu.information")}</label>
                            </a></li>
                            <li><a id="aMenuSecurity" class="menu-item">
                                <Icon name="solar:shield-keyhole-bold" width={20} height={20} />
                                <label>{t("profile.menu.security")}</label>
                            </a></li>
                            <li><a id="aMenuData" class="menu-item">
                                <Icon name="solar:database-bold-duotone" width={20} height={20} />
                                <label>{t("profile.menu.data")}</label>
                            </a></li>
                        </ul>
                    </aside>
                </div>
                <div id="dItems" class="content">
                    <div id="dInformation" class="card">
                        <div class="card-content">
                            <div class="profileHero">
                                <div class="profileAvatar">
                                    <Icon id="iIPIcon" name="solar:user-bold" width={52} height={52} color="white" />
                                    <img id="iIPPhoto" alt="profile" style="display: none" />
                                    <button id="btnIPPhotoEdit" class="btn-avatar-edit" title={t("shared.edit")}>
                                        <Icon name="material-symbols:edit-rounded" width={16} height={16} />
                                    </button>
                                    <input id="iIPPhotoEdit" type="file" 
                                        accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                                        style="display: none" />
                                </div>
                                <h4 id="lIPName" class="profileHeroName">{t("shared.name")}</h4>
                                <div id="dInformationShow" class="profileEmailRow">
                                    <span class="profileEmailRow-icon"><Icon name="solar:letter-bold" width={15} height={15} /></span>
                                    <span id="dIEEmail">{t("shared.email")}</span>
                                </div>
                            </div>

                            <div id="dInformationEditName" class="profileForm" style="display: none">
                                <div class="field">
                                    <label class="label">{t("shared.name")}</label>
                                    <div class="control">
                                        <input id="iIENInput" class="input" type="text" />
                                    </div>
                                </div>
                                <div class="profileFormActions">
                                    <button id="btnIENCancel" class="btn-danger">{t("shared.cancel")}</button>
                                    <button id="btnIENUpdate" class="btn-primary">{t("shared.update")}</button>
                                </div>
                            </div>

                            <div id="dInformationEditEmail" class="profileForm" style="display: none">
                                <div class="field">
                                    <label class="label">{t("shared.email")}</label>
                                    <div class="control profileInlineControl">
                                        <input id="iIEEInput" class="input" type="email" />
                                        <button id="btnIEEVerify" class="btn-primary">{t("profile.information.updateEmail.verify")}</button>
                                    </div>
                                </div>
                                <div id="dIEECodeVerification" class="field" style="display: none;">
                                    <label class="label">{t("shared.codeVerification")}</label>
                                    <div class="control">
                                        <input id="iIEECVInput" class="input" type="number" />
                                    </div>
                                </div>
                                <div class="profileFormActions">
                                    <button id="btnIEECancel" class="btn-danger">{t("shared.cancel")}</button>
                                    <button id="btnIEEUpdate" class="btn-primary" disabled>{t("shared.update")}</button>
                                </div>
                            </div>

                            <div id="dInformationOptions" class="profileActions">
                                <button id="btnIOUpdateName" class="btn-outline">
                                    <Icon name="solar:user-bold" width={17} height={17} />
                                    {t("profile.information.updateName.title")}
                                </button>
                                <button id="btnIOUpdateEmail" class="btn-outline">
                                    <Icon name="solar:letter-bold" width={17} height={17} />
                                    {t("profile.information.updateEmail.title")}
                                </button>
                            </div>

                            <div class="profileMeta">
                                <span id="sICreatedAt">{t("profile.information.createAt", { date: "..." })}</span>
                                <span id="sILastUpdate" style="display: none">{t("profile.information.lastUpdate", { date: "..." })}</span>
                            </div>
                        </div>
                    </div>

                    <div id="dSecurity" class="card" style="display: none">
                        <div class="card-content">
                            <div class="settingRow">
                                <div class="settingIcon">
                                    <Icon name="solar:lock-keyhole-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("shared.password")}</span>
                                    <span class="settingDesc">{t("profile.security.passwordDesc")}</span>
                                </div>
                                <button id="btnSUpdatePassword" class="btn-primary">{t("shared.update")}</button>
                            </div>
                            <div class="settingRow">
                                <div class="settingIcon">
                                    <Icon name="solar:shield-keyhole-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("shared.codeVerification")}</span>
                                    <span class="settingDesc">{t("profile.security.twoStepDesc")}</span>
                                </div>
                                <button id="btnSUpdateTwoStep" class="btn-primary">{t("shared.manage")}</button>
                            </div>
                        </div>
                    </div>

                    <div id="dData" class="card" style="display: none">
                        <div class="card-content">
                            <div class="settingRow">
                                <div class="settingIcon">
                                    <Icon name="solar:upload-minimalistic-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("profile.data.import.title")}</span>
                                    <span class="settingDesc">{t("profile.data.import.desc")}</span>
                                </div>
                                <button id="btnDImportCsv" class="btn-primary">CSV</button>
                            </div>
                            <div class="settingRow">
                                <div class="settingIcon">
                                    <Icon name="solar:download-minimalistic-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("profile.data.export.title")}</span>
                                    <span class="settingDesc">{t("profile.data.export.desc")}</span>
                                </div>
                                <button id="btnDExportCsv" class="btn-primary">CSV</button>
                            </div>
                            <div class="settingRow">
                                <div class="settingIcon">
                                    <Icon name="solar:code-square-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("profile.data.apiUrl.title")}</span>
                                    <span class="settingDesc">{t("profile.data.apiUrl.desc")}</span>
                                </div>
                                <button id="btnDShowApiUrl" class="btn-primary">{t("profile.data.backendShow")}</button>
                            </div>
                            <div class="settingRow settingRow-danger">
                                <div class="settingIcon">
                                    <Icon name="solar:trash-bin-trash-bold" width={22} height={22} />
                                </div>
                                <div class="settingInfo">
                                    <span class="settingTitle">{t("profile.data.deleteAll.title")}</span>
                                    <span class="settingDesc">{t("profile.data.deleteAll.desc")}</span>
                                </div>
                                <button id="btnDDeleteAllData" class="btn-danger">{t("profile.data.deleteAll.action")}</button>
                            </div>
                            <progress id="pDProgress" class="progress" max="100" style="display: none"></progress>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Content>

    <Base id="mUpdatePassword" title={t("shared.passwordUpdate")}>
        <section class="modal-body">
            <div class="field">
                <label class="label">{t("shared.passwordCurrent")}</label>
                <div class="control">
                    <input id="iMUPCurrentPassword" class="input" type="password" />
                </div>
            </div>
            <div class="field">
                <label class="label">{t("shared.passwordNew")}</label>
                <div class="control">
                    <input id="iMUPNewPassword" class="input" type="password" />
                </div>
            </div>
            <div class="field">
                <label class="label">{t("shared.passwordConfirm")}</label>
                <div class="control">
                    <input id="iMUPConfirmPassword" class="input" type="password" />
                </div>
            </div>
        </section>
        <footer class="modal-footer">
            <button id="btnMUPCancel" class="btn-danger">{t("shared.cancel")}</button>
            <button id="btnMUPAccept" class="btn-primary">{t("shared.update")}</button>
        </footer>
    </Base>
    <Base id="mUpdateTwoStep" title={t("shared.codeVerification")}>
        <section class="modal-body">
            <div class="option">
                <label class="label">{t("profile.security.active")}</label>
                <label class="switch is-rounded">
                    <input id="iMUTSActive" type="checkbox" />
                    <span class="check"></span>
                </label>
            </div>
            <div class="option">
                <label class="label">{t("profile.security.type")}</label>
                <div class="control">
                    <div class="select">
                        <select id="sMUTSType">
                            <option value="Email">{t("shared.email")}</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>
        <footer class="modal-footer">
            <button id="btnMUTSCancel" class="btn-danger">{t("shared.cancel")}</button>
            <button id="btnMUTSAccept" class="btn-primary">{t("shared.accept")}</button>
        </footer>
    </Base>
    <Confirm locale={locale} />
    <Alert locale={locale} />
    <script>import "../../scripts/profile";</script>
</Layout>
