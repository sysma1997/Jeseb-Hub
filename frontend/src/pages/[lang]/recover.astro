---
import type { GetStaticPaths } from "astro";
import { getLocaleFromUrl, createTranslations } from "../../core/shared/infrastructure/i18n/server";

import { Icon } from "astro-icon/components";

import Layout from "../../layouts/Layout.astro";
import Options from "../../components/shared/Options.astro";

import Form from "../../components/Form.astro";
import Alert from "../../components/modals/Alert.astro";

import "../../styles/shared/auth.css";

export const getStaticPaths = (() => {    
    return [
        { params: { lang: "en" } }, 
        { params: { lang: "es" } }
    ];
}) satisfies GetStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslations(locale);
---

<Layout locale={locale} title={t("recover.title")}>
    <Options locale={locale} />
    <div class="auth-container">
        <img id="icon" class="auth-logo" src="/favicon/icon.svg" alt="Jeseb Hub" />
        <script is:inline>
			(function() {
				const theme = localStorage.getItem('theme');
				const id = document.getElementById("icon");
                id.src = (theme === "dark") ? "/favicon/icon-dark.svg" : "/favicon/icon.svg";
			})();
		</script>
        <Form title={t("recover.title")}>
            <div id="dEmail" class="form-field">
                <label class="form-label" for="inEmail">{t("recover.email")}</label>
                <div class="form-input-wrapper">
                    <input id="inEmail" class="form-input" type="email" placeholder="Email" />
                    <span class="form-input-icon"><Icon name="material-symbols:mail" /></span>
                </div>
            </div>
            <div id="dPassword" class="form-field" style="display: none;">
                <label class="form-label" for="inPassword">{t("shared.passwordNew")}:</label>
                <div class="form-input-wrapper">
                    <input id="inPassword" class="form-input" type="password" />
                    <span class="form-input-icon"><Icon name="solar:lock-password-bold" /></span>
                </div>
            </div>
            <div id="dConfirmPassword" class="form-field" style="display: none;">
                <label class="form-label" for="inConfirmPassword">{t("shared.passwordConfirm")}:</label>
                <div class="form-input-wrapper">
                    <input id="inConfirmPassword" class="form-input" type="password" />
                    <span class="form-input-icon"><Icon name="solar:lock-password-bold" /></span>
                </div>
            </div>

            <div class="auth-info">
                <span>{t("recover.back.description")} <a href={`/${locale}/login`}><b>{t("recover.back.link")}</b></a>.</span>
            </div>

            <button id="btnRecover" class="btn btn-primary">{t("recover.recover")}</button>
        </Form>
    </div>

    <Alert locale={locale} />

    <script>import "../../scripts/recover";</script>
</Layout>
