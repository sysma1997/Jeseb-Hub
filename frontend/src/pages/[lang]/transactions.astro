---
import type { GetStaticPaths } from "astro";
import { getLocaleFromUrl, createTranslations } from "../../core/shared/infrastructure/i18n/server";

import Layout from "../../layouts/Layout.astro";
import Content from "../../components/shared/Content.astro";

import Base from "../../components/modals/Base.astro";
import Alert from "../../components/modals/Alert.astro";
import Confirm from "../../components/modals/Confirm.astro";

import { TransactionList } from "../../components/transactions/TransactionList";

import "../../styles/transactions/index.css";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } }, 
		{ params: { lang: "es" } }
	];
}) satisfies GetStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslations(locale);
---

<Layout locale={locale} title={t("transactions.title")}>
	<Content locale={locale}>
		<div class="transactions">
			<div class="transactionsContent">
				<p id="pSTitle" class="transactionsTitle">{t("transactions.summary.title")}</p>
				<div id="dSTags" class="transactionsTags">
				</div>
				<div class="summary">
					<div class="summaryCard">
						<span class="summaryCard-label">{t("transactions.summary.income")}</span>
						<span id="lSIncome" class="summaryCard-value">...</span>
					</div>
					<div class="summaryCard">
						<span class="summaryCard-label">{t("transactions.summary.expenses")}</span>
						<span id="lSExpenses" class="summaryCard-value">...</span>
					</div>
					<div class="summaryCard">
						<span class="summaryCard-label">{t("transactions.summary.diff")}</span>
						<span id="lSDiff" class="summaryCard-value">...</span>
					</div>
				</div>
				<TransactionList client:only="react" />
			</div>
		</div>
	</Content>

	<Base id="modalFilterTransactions" title={t("shared.filter")}>
		<div class="modal-body">
			<div class="field">
				<label class="label">{t("transactions.filter.dateRange")}:</label>
				<div class="field has-addons">
					<div class="control" style="flex: 1;">
						<input id="iMFTDateFrom" class="input" type="date" />
					</div>
					<div class="control" style="flex: 1;">
						<input id="iMFTDateTo" class="input" type="date" />
					</div>
					<div class="control">
						<button id="btnMFTClear" class="btn-primary">{t("shared.clear")}</button>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.account")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTAccount">
							<option value="all">{t("transactions.filter.all")}</option>
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.category")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTCategory">
							<option value="all">{t("transactions.filter.all")}</option>
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.type")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTType">
							<option value="all">{t("transactions.filter.all")}</option>
							<option value="true">{t("transactions.ingress")}</option>
							<option value="false">{t("transactions.egress")}</option>
						</select>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
            <button id="btnMFTCancel" class="btn-danger">{t("shared.cancel")}</button>
			<button id="btnMFTClearFilters" class="btn-info">{t("shared.clear")}</button>
            <button id="btnMFTAccept" class="btn-primary">{t("shared.accept")}</button>
        </div>
	</Base>
	<Base id="modalAddTransaction" title={t("transactions.add")}>
		<div class="modal-body">
			<div class="field" id="dMATOperation">
				<label class="label">{t("transactions.operation")}:</label>
				<div class="segment" id="gMATOperation">
					<button type="button" id="btnMATOpTransaction" class="segment-btn is-active">{t("transactions.operationTransaction")}</button>
					<button type="button" id="btnMATOpTransfer" class="segment-btn">{t("transactions.operationTransfer")}</button>
				</div>
			</div>

			<div class="field" id="dMATAccount">
				<label class="label">{t("transactions.account")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATAccount"></select>
					</div>
				</div>
				<label id="lMATAccountBalance">{t("shared.balance")}: 0</label>
			</div>

			<div class="field" id="dMATFrom">
				<label class="label">{t("transfers.from")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATFrom"></select>
					</div>
				</div>
				<label id="lMATFromBalance">{t("shared.balance")}: 0</label>
			</div>

			<div class="field" id="dMATTo">
				<label class="label">{t("transfers.to")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATTo"></select>
					</div>
				</div>
				<label id="lMATToBalance">{t("shared.balance")}: 0</label>
			</div>

			<div class="field" id="dMATType">
				<label class="label">{t("transactions.type")}:</label>
				<div class="segment" id="gMATType">
					<button type="button" id="btnMATIngress" class="segment-btn is-active">{t("transactions.ingress")}</button>
					<button type="button" id="btnMATEgress" class="segment-btn">{t("transactions.egress")}</button>
				</div>
			</div>

			<div class="field">
				<label class="label">{t("transactions.value")}:</label>
				<div class="control">
					<input id="iMATValue" class="input" type="number" placeholder="0.00" />
				</div>
			</div>

			<div class="field">
				<label class="label">{t("transactions.date")}:</label>
				<div class="control">
					<input id="iMATDate" class="input" type="datetime-local" />
				</div>
			</div>

			<div class="field" id="dMATCategory">
				<label class="label">{t("transactions.category")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATCategory"></select>
					</div>
				</div>
			</div>

			<div class="field">
				<label class="label">{t("transactions.description")}:</label>
				<div class="control">
					<textarea id="taMATDescription" class="textarea"></textarea>
				</div>
			</div>
			<p id="pMATMessage" class="mat-message"></p>
		</div>
		<div class="modal-footer">
            <button id="btnMATCancel" class="btn-danger">{t("shared.cancel")}</button>
            <button id="btnMATAccept" class="btn-primary">{t("shared.add")}</button>
        </div>
	</Base>
	<Base id="modalTransaction" title={t("transactions.title")}>
		<div class="modal-body">
			<div class="item">
				<label>{t("transactions.account")}:</label>
				<p id="pMTAccount">.</p>
			</div>
			<div class="item">
				<label>{t("transactions.type")}:</label>
				<p id="pMTType">.</p>
			</div>
			<div class="item">
				<label>{t("transactions.value")}:</label>
				<p id="pMTValue">.</p>
			</div>
			<div class="item">
				<label>{t("transactions.date")}:</label>
				<p id="pMTDate">.</p>
			</div>
			<div id="dMTCategory" class="item" style="display: none;">
				<label>{t("transactions.category")}:</label>
				<p id="pMTCategory">.</p>
			</div>
			<div id="dMTDescription" class="item" style="display: none;">
				<label>{t("transactions.description")}:</label>
				<p id="pMTDescription">.</p>
			</div>
		</div>
		<div class="modal-footer">
            <button id="btnMTOk" class="btn-primary">Ok</button>
        </div>
	</Base>
	<Confirm locale={locale} />
	<Alert locale={locale} />
	<script>import "../../scripts/transactions/index";</script>
</Layout>
