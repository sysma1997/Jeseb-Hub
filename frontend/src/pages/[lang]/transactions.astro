---
import type { GetStaticPaths } from "astro";
import { getLocaleFromUrl, createTranslations } from "../../core/shared/infrastructure/i18n/server";

import Layout from "../../layouts/Layout.astro";
import Content from "../../components/shared/Content.astro";

import Base from "../../components/modals/Base.astro";
import Alert from "../../components/modals/Alert.astro";
import Confirm from "../../components/modals/Confirm.astro";

import { TransactionList } from "../../components/transactions/TransactionList";

import "../../styles/transactions/index.css";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } }, 
		{ params: { lang: "es" } }
	];
}) satisfies GetStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslations(locale);
---

<Layout locale={locale} title={t("transactions.title")}>
	<Content locale={locale}>
		<div class="transactions">
			<div class="transactionsContent">
				<p id="pSTitle" class="is-size-5"><b>{t("transactions.summary.title")}</b></p>
				<div id="dSTags">
				</div>
				<div class="summary">
					<div class="box">
						<label>{t("transactions.summary.income")}:</label>
						<label id="lSIncome" class="has-text-right">...</label>
					</div>
					<div class="box">
						<label>{t("transactions.summary.expenses")}:</label>
						<label id="lSExpenses" class="has-text-right">...</label>
					</div>
					<div class="box">
						<label>{t("transactions.summary.diff")}:</label>
						<label id="lSDiff" class="has-text-right">...</label>
					</div>
					<div></div>
				</div>
				<TransactionList client:only="react" />
			</div>
		</div>
	</Content>

	<Base id="modalFilterTransactions" title={t("shared.filter")}>
		<section class="modal-card-body">
			<div class="field">
				<label class="label">{t("transactions.filter.dateRange")}:</label>
				<div class="field has-addons">
					<div class="control" style="flex: 1;">
						<input id="iMFTDateFrom" class="input" type="date" />
					</div>
					<div class="control" style="flex: 1;">
						<input id="iMFTDateTo" class="input" type="date" />
					</div>
					<div class="control">
						<button id="btnMFTClear" class="button is-primary">{t("shared.clear")}</button>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.account")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTAccount">
							<option value="all">{t("transactions.filter.all")}</option>
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.category")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTCategory">
							<option value="all">{t("transactions.filter.all")}</option>
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.type")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMFTType">
							<option value="all">{t("transactions.filter.all")}</option>
							<option value="true">{t("transactions.ingress")}</option>
							<option value="false">{t("transactions.egress")}</option>
						</select>
					</div>
				</div>
			</div>
		</section>
		<footer class="modal-card-foot" style="gap: 0.5rem;">
            <button id="btnMFTCancel" class="button is-danger is-fullwidth">{t("shared.cancel")}</button>
			<button id="btnMFTClearFilters" class="button is-info is-fullwidth">{t("shared.clear")}</button>
            <button id="btnMFTAccept" class="button is-primary is-fullwidth">{t("shared.accept")}</button>
        </footer>
	</Base>
	<Base id="modalAddTransaction" title={t("transactions.add")}>
		<section id="sMAT1" class="modal-card-body" style="display: block;">
			<div class="field">
				<label class="label">{t("transactions.account")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATAccount"></select>
					</div>
				</div>
			</div>
			<label id="lMATAccountBalance">{t("shared.balance")}: 0</label>
		</section>
		<section id="sMAT2" class="modal-card-body" style="display: none;">
			<div class="field">
				<label class="label">{t("transactions.type")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATType">
							<option value="true">{t("transactions.ingress")}</option>
							<option value="false">{t("transactions.egress")}</option>
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.value")}:</label>
				<div class="control">
					<input id="iMATValue" class="input" type="number" />
				</div>
			</div>
		</section>
		<section id="sMAT3" class="modal-card-body" style="display: none;">
			<p style="margin-bottom: 1.5rem;">{t("transactions.optional")}</p>
			<div class="field">
				<label class="label">{t("transactions.date")}:</label>
				<div class="control">
					<input id="iMATDate" class="input" type="datetime-local" />
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.category")}:</label>
				<div class="control">
					<div class="select is-fullwidth">
						<select id="sMATCategory"></select>
					</div>
				</div>
			</div>
			<div class="field">
				<label class="label">{t("transactions.description")}:</label>
				<div class="control">
					<textarea id="taMATDescription" class="textarea" />
				</div>
			</div>
		</section>
		<section id="sMAT4" class="modal-card-body" style="display: none;">
			<p style="margin-bottom: 1.5rem;">{t("transactions.confirm")}:</p>
			<div class="item">
				<label class="label">{t("transactions.account")}:</label>
				<p id="pMATAccountConfirm">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.type")}:</label>
				<p id="pMATTypeConfirm">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.value")}:</label>
				<p id="pMATValueConfirm">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.date")}:</label>
				<p id="pMATDateConfirm">.</p>
			</div>
			<div id="dMATCategoryConfirm" class="item" style="display: none;">
				<label class="label">{t("transactions.category")}:</label>
				<p id="pMATCategoryConfirm">.</p>
			</div>
			<div id="dMATDescriptionConfirm" class="item" style="display: none;">
				<label class="label">{t("transactions.description")}:</label>
				<p id="pMATDescriptionConfirm">.</p>
			</div>
		</section>
		<section id="sMAT5" class="modal-card-body" style="display: none;">
			<p id="pMATMessage">{t("transactions.created")}</p>
		</section>
		<footer class="modal-card-foot" style="gap: 0.5rem;">
            <button id="btnMATCancel" class="button is-danger is-fullwidth">{t("shared.cancel")}</button>
            <button id="btnMATAccept" class="button is-primary is-fullwidth">{t("shared.next")}</button>
        </footer>
	</Base>
	<Base id="modalTransaction" title={t("transactions.title")}>
		<section class="modal-card-body">
			<div class="item">
				<label class="label">{t("transactions.account")}:</label>
				<p id="pMTAccount">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.type")}:</label>
				<p id="pMTType">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.value")}:</label>
				<p id="pMTValue">.</p>
			</div>
			<div class="item">
				<label class="label">{t("transactions.date")}:</label>
				<p id="pMTDate">.</p>
			</div>
			<div id="dMTCategory" class="item" style="display: none;">
				<label class="label">{t("transactions.category")}:</label>
				<p id="pMTCategory">.</p>
			</div>
			<div id="dMTDescription" class="item" style="display: none;">
				<label class="label">{t("transactions.description")}:</label>
				<p id="pMTDescription">.</p>
			</div>
		</section>
		<footer class="modal-card-foot" style="gap: 0.5rem;">
            <button id="btnMTOk" class="button is-primary is-fullwidth">Ok</button>
        </footer>
	</Base>
	<Confirm locale={locale} />
	<Alert locale={locale} />
	<script>import "../../scripts/transactions/index";</script>
</Layout>
