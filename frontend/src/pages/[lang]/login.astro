---
import type { GetStaticPaths } from "astro";
import { getLocaleFromUrl, createTranslations } from "../../core/shared/infrastructure/i18n/server";

import { Icon } from "astro-icon/components";

import Layout from "../../layouts/Layout.astro";
import Options from "../../components/shared/Options.astro";

import Form from "../../components/Form.astro";
import Base from "../../components/modals/Base.astro";
import Alert from "../../components/modals/Alert.astro";

import "../../styles/shared/auth.css";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } }, 
		{ params: { lang: "es" } }
	];
}) satisfies GetStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslations(locale);
---

<Layout locale={locale} title={t("login.title")}>
    <Options locale={locale} />
    <div class="auth-container">
        <img id="icon" class="auth-logo" src="/favicon/icon.svg" alt="Jeseb Hub" />
        <script is:inline>
			(function() {
				const theme = localStorage.getItem('theme');
				const id = document.getElementById("icon");
                id.src = (theme === "dark") ? "/favicon/icon-dark.svg" : "/favicon/icon.svg";
			})();
		</script>
        <Form title={t("login.title")}>
            <div class="form-field">
                <label class="form-label" for="inEmail">{t("shared.email")}</label>
                <div class="form-input-wrapper">
                    <input id="inEmail" class="form-input" type="email" />
                    <span class="form-input-icon"><Icon name="material-symbols:mail" /></span>
                </div>
            </div>
            <div class="form-field">
                <label class="form-label" for="inPassword">{t("shared.password")}</label>
                <div class="form-input-wrapper">
                    <input id="inPassword" class="form-input" type="password" />
                    <span class="form-input-icon"><Icon name="solar:lock-password-bold" /></span>
                </div>
            </div>

            <div class="auth-info">
                <span>{t("login.passwordRecovery.description")} <a href={`/${locale}/recover`}><b>{t("login.passwordRecovery.link")}</b></a>.</span>
                <span>{t("login.register.description")} <a href={`/${locale}/register`}><b>{t("login.register.link")}</b></a>.</span>
            </div>

            <button id="btnLogin" class="btn btn-primary">{t("login.signIn")}</button>
        </Form>
    </div>

    <Base id="mTwoStep" title={t("shared.codeVerification")}>
        <div class="modal-body">
            <div class="field">
                <label id="mtsMessage" class="label">{t("shared.codeVerification")}</label>
                <div class="control">
                    <input id="iMTSCode" class="input" type="number" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button id="btnMTSCancel" class="btn-danger">{t("shared.cancel")}</button>
            <button id="btnMTSAccept" class="btn-primary">{t("shared.accept")}</button>
        </div>
    </Base>
    <Alert locale={locale} />

    <script>import "../../scripts/login";</script>
</Layout>
