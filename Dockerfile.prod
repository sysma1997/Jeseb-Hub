FROM node:22-alpine AS base
RUN npm install -g pnpm@11.1.3
WORKDIR /usr/local/app

FROM base AS backend-build
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY backend/. ./
COPY .git .git
RUN apk add --no-cache git && \
    printf '{"version":"%s","commit":"%s"}' \
        "$(git describe --tags --always --dirty | sed 's/^v//')" \
        "$(git rev-parse --short HEAD)" > /usr/local/app/version.json && \
    apk del git && rm -rf .git
RUN mkdir -p /usr/local/app/uploads
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" pnpm exec prisma generate
RUN pnpm run build

FROM base AS backend
WORKDIR /usr/local/app
COPY --from=backend-build /usr/local/app/dist ./dist
COPY --from=backend-build /usr/local/app/node_modules ./node_modules
COPY --from=backend-build /usr/local/app/package.json ./
COPY --from=backend-build /usr/local/app/prisma ./prisma
COPY --from=backend-build /usr/local/app/prisma.config.ts ./
COPY --from=backend-build /usr/local/app/version.json ./version.json
RUN mkdir -p /usr/local/app/uploads
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/index.js"]

FROM base AS frontend-build
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
ARG FRONTEND_BACKEND_URL
ENV PUBLIC_BACKEND_URL=$FRONTEND_BACKEND_URL
COPY frontend/. ./
RUN pnpm run build

FROM nginx:alpine AS frontend
COPY --from=frontend-build /usr/local/app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

FROM base AS landing-build
COPY landing/package.json landing/pnpm-lock.yaml landing/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
ARG LANDING_FRONTEND_URL
ENV PUBLIC_LANDING_FRONTEND_URL=$LANDING_FRONTEND_URL
COPY landing/. ./
RUN pnpm run build

FROM nginx:alpine AS landing
COPY --from=landing-build /usr/local/app/dist /usr/share/nginx/html
COPY landing/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
