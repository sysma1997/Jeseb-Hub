generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource storage {
    provider = "postgresql"
}

model User {
    id String @id @default(uuid())
    name String
    email String @unique
    password String
    createAt DateTime @default(now())
    lastUpdate DateTime?
    profile String?
    config Json?

    transactions Transaction[]
    accounts Account[]
    categories Category[]

    @@map("users")
}
model Transaction {
    id String @id @default(uuid())
    idUser String
    date DateTime @default(now())
    type Boolean
    account String
    value Decimal
    category String?
    description String?
    transferId String?
    isTransfer Boolean @default(false)

    user User @relation(fields: [idUser], references: [id])

    @@map("transactions")
}
model Account {
    id String @id @default(uuid())
    idUser String
    name String
    balance Decimal

    user User @relation(fields: [idUser], references: [id])

    @@map("accounts")
}
model Category {
    id String @id @default(uuid())
    idUser String
    name String

    user User @relation(fields: [idUser], references: [id])

    @@map("categories")
}